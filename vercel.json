{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/checkmyurl/", "destination": "https://checkmyurl.vercel.app/" },
    { "source": "/checkmyurl/:path*", "destination": "https://checkmyurl.vercel.app/:path*" },
    { "source": "/portfolio/", "destination": "https://rajeshsood-portfolio.vercel.app/" },
    { "source": "/portfolio/:path*", "destination": "https://rajeshsood-portfolio.vercel.app/:path*" },
    { "source": "/subnet-calculator/", "destination": "https://simple-subnet-calculator.vercel.app/" },
    { "source": "/subnet-calculator/:path*", "destination": "https://simple-subnet-calculator.vercel.app/:path*" },
    { "source": "/notesmith/", "destination": "https://mynotesmith.vercel.app/" },
    { "source": "/notesmith/:path*", "destination": "https://mynotesmith.vercel.app/:path*" }
  ]
}
